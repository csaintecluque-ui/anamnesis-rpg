{
  "name": "anamnesis-rpg",
  "version": "0.1.0",
  "description": "Anamnesis — RPG 2D isométrique au tour par tour",
  "private": true,
  "license": "UNLICENSED",
  "author": "Cyril (CSC)",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "npm run typecheck && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.node.json",
    "test": "vitest run",
    "icons": "node scripts/generate-icons.mjs",
    "tiles": "node scripts/generate-tiles.mjs",
    "maps": "node scripts/build-maps.mjs"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/csaintecluque-ui/anamnesis-rpg.git"
  },
  "dependencies": {
    "phaser": "3.90.0"
  },
  "devDependencies": {
    "@resvg/resvg-js": "2.6.2",
    "@types/node": "24.19.2",
    "typescript": "7.0.2",
    "vite": "8.3.5",
    "vite-plugin-pwa": "2.0.0",
    "vitest": "5.0.5"
  }
}
