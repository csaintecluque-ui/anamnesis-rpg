  "nodes": {
    "levier": {
      "text": "Le levier de l’embranchement, peint en rouge. Une plaque : « Embranchement de la Cendrière — fermé au trafic ».",
      "options": [
        {
          "text": "Laisser le levier.",
          "next": "fin"
        }
      ]
    },
    "goupille": {
      "text": "Graissé de frais. Et la goupille de sécurité, qui bloque le levier la nuit, a été limée net : quelqu’un d’ici l’ouvre et le referme, sans forcer.",
