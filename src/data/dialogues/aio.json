      ],
      "options": [
        {
          "text": "Partir.",
          "next": "fin"
        }
      ]
    },
    "raconte-special": {
      "text": "Aïo ne dit rien pendant longtemps. Puis : — Moi, je tombe pas. Je plonge. C’est pas pareil. Il serre son panier contre lui. — Pim, elle avait des rubans. Moi, j’ai des perles.",
      "effects": [
        {
          "setFlag": "raconte-aio"
        },
        {
          "giveXp": 15
        }
      ],
      "options": [
        {
          "text": "Merci, Aïo.",
          "next": "fin"
        }
      ]
    },
    "raconte-touche": {
      "text": "Aïo écoute la bouche ouverte. — Encore ! Une autre !",
