  "nodes": {
    "accueil": {
      "text": "Un garçon de dix ans, un panier vide sous le bras. — T’as déjà plongé ? Moi, je tiens deux minutes. Ondine dit que c’est rien. Ondine en tient dix, mais elle a des branchies : c’est de la triche.",
      "options": [
        {
          "text": "Les plongeurs remontent ce qu’on donne à la mer ?",
          "requires": [
            {
              "quest": "don-rendu",
              "status": "active"
            },
            {
              "notFlag": "don-rendu-indice"
            }
          ],
          "next": "bagues"
        },
        {
          "text": "Je te raconte une histoire ?",
          "requires": [
            {
              "notFlag": "raconte-aio"
            }
          ],
          "next": "raconte-neutre",
          "raconter": {
            "aime": [
              "familles"
            ],
            "recits": {
              "echelle-de-pim": "raconte-special"
            },
            "touche": "raconte-touche",
            "neutre": "raconte-neutre"
          }
        },
        {
          "text": "Au revoir, Aïo.",
          "next": "fin"
        }
      ]
    },
    "bagues": {
      "text": "— Pas moi ! Je le jure sur Marethis. Mais Tadéo, aux Canaux, il a des bagues à vendre, des fois. Il dit qu’il les trouve.",
      "effects": [
        {
          "setFlag": "don-rendu-indice"
        }
      ],
      "options": [
        {
          "text": "Merci, Aïo.",
          "next": "fin"
        }
      ]
    },
    "lune": {
      "text": "Aïo remplit un sac de pierres pour descendre plus vite. — Cette nuit, la lune sera rouge. Les perles noires remontent sous la lune rouge. Une seule, et maman a son remède. Tu ne le diras pas, hein ?",
      "effects": [
        {
          "startQuest": "lune-rouge"
        }
      ],
      "options": [
        {
          "text": "« Ne plonge jamais seul sous une lune rouge. »",
          "next": "empeche",
          "roll": {
            "skill": "diplomacy",
            "difficulty": 16
          },
          "failNext": "obstine"
        },
        {
          "text": "Je plonge avec toi. Tu ne seras pas seul.",
          "next": "ensemble",
          "roll": {
            "skill": "athletics",
            "difficulty": 16
          },
          "failNext": "ensemble-dur"
        },
        {
          "text": "Combien coûte le remède ?",
          "next": "prix"
        },
        {
          "text": "C’est ton choix.",
          "next": "seul"
        }
      ]
    },
    "obstine": {
      "text": "— Tu parles comme Ondine. Il resserre son sac.",
      "options": [
        {
          "text": "Je plonge avec toi.",
          "next": "ensemble",
          "roll": {
            "skill": "athletics",
            "difficulty": 16
          },
          "failNext": "ensemble-dur"
        },
        {
          "text": "Combien coûte le remède ?",
          "next": "prix"
        },
        {
          "text": "C’est ton choix.",
          "next": "seul"
        }
      ]
    },
    "prix": {
      "text": "— Soixante Fers. Maman dit que c’est le prix d’un bateau. C’est pas vrai, mais presque.",
      "options": [
        {
          "text": "Les voilà.",
          "requires": [
            {
              "fers": 60
            }
          ],
          "next": "paye",
          "effects": [
            {
              "giveFers": -60
            },
