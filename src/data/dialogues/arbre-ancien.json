  "nodes": {
    "arbre": {
      "text": "Un très vieil arbre, couvert de colonnes de signes gravés en verdani. En grandissant, le bois a fendu certains signes ; personne ne les corrige.",
      "options": [
        {
          "text": "Poser la main sur les signes gravés et écouter.",
          "requires": [
            {
              "attribute": "memory",
              "min": 3
            },
            {
              "notFlag": "recit-voix-ecorce-recu"
            }
          ],
          "next": "voix",
          "effects": [
            {
              "setFlag": "recit-voix-ecorce-recu"
            },
            {
              "learnRecit": "voix-ecorce"
            },
            {
              "giveXp": 10
            }
          ]
        },
        {
          "text": "Écouter encore les voix.",
          "requires": [
            {
              "attribute": "memory",
              "min": 3
            },
            {
              "flag": "recit-voix-ecorce-recu"
            }
          ],
          "next": "voix"
        },
        {
          "text": "Lire quelques noms.",
          "next": "noms"
        },
        {
          "text": "Partir.",
          "next": "fin"
        }
      ]
    },
    "voix": {
      "text": "Des souvenirs qui ne sont pas les tiens montent sous tes doigts : des mains qui gravent, des rires, une berceuse, un nom murmuré. Ceux qui ont gravé ici te parlent encore.",
      "options": [
        {
          "text": "Laisser les voix se taire.",
          "next": "fin"
        }
      ]
    },
    "noms": {
      "text": "Des noms, des légendes, de petits dessins de feuilles. Là où le bois a fendu un signe, la fente fait désormais partie du souvenir.",
      "apartes": {
        "liane": "Liane pose la main près de la tienne, sur les noms. — Eux, ils gardent leurs morts dans le bois. Chez nous, on les enterre et on se tait."
      },
      "options": [
        {
          "text": "Partir.",
          "next": "fin"
        }
      ]
    },
    "silence": {
      "text": "Le très vieil arbre gravé. Sous ta main, les signes restent froids : ni voix ni souvenir ne montent du bois.",
      "options": [
        {
          "text": "Écouter plus profond.",
          "next": "pente",
          "requires": [
            {
              "attribute": "memory",
              "min": 3
            },
            {
              "notFlag": "piste-racines"
            }
          ],
          "effects": [
            {
              "setFlag": "piste-racines"
            },
            {
              "giveXp": 10
            }
          ]
        },
        {
          "text": "Examiner le pied de l’arbre.",
          "next": "seve",
          "roll": {
            "skill": "investigation",
            "difficulty": 11
          },
          "failNext": "pied-rien",
          "requires": [
            {
              "notFlag": "piste-racines"
            },
            {
              "notFlag": "pied-arbre-rate"
            }
          ],
          "effects": [
            {
              "setFlag": "piste-racines"
            },
            {
              "giveXp": 10
            }
          ]
        },
        {
          "text": "Confier une de tes histoires au vieil arbre.",
          "next": "silence",
          "requires": [
            {
              "notFlag": "piste-racines"
            }
          ],
          "raconter": {
            "donne": true,
            "neutre": "confie"
          }
        },
        {
          "text": "Partir.",
          "next": "fin"
        }
      ]
    },
    "pied-rien": {
      "text": "Tu fouilles la mousse au pied de l’arbre. De la terre, des racines, un scarabée qui s’enfuit. Rien qui parle, aujourd’hui.",
      "options": [
        {
          "text": "Revenir à l’arbre.",
          "next": "silence"
        },
        {
          "text": "Partir.",
          "next": "fin"
        }
      ],
      "effects": [
        {
          "setFlagFor": "pied-arbre-rate",
          "days": 1
        }
      ]
    },
    "pente": {
      "text": "Tout au fond du silence, une sensation : une racine qu’on tire, vers le bas, très loin sous la ville. Ce qui fait taire le Bosquet est en bas, sur le Sol des Racines.",
      "options": [
        {
          "text": "Retirer la main.",
          "next": "fin"
        }
      ]
    },
    "seve": {
      "text": "Au pied de l’arbre, une sève claire suinte entre les planches, comme d’une blessure. Les racines du Bosquet descendent jusqu’au sol, et, en bas, quelque chose les a tranchées.",
      "options": [
        {
          "text": "Partir.",
          "next": "fin"
        }
      ]
    },
    "confie": {
      "text": "Tu poses la main sur l’écorce froide et tu racontes. Le bois boit ton histoire jusqu’au dernier mot. Un nom se réchauffe sous tes doigts, puis quelque chose tire, vers le bas, très loin sous la ville. L’histoire ne te revient pas.",
      "effects": [
        {
          "setFlag": "piste-racines"
        },
        {
          "giveXp": 10
        }
      ],
      "options": [
        {
          "text": "Retirer la main.",
          "next": "fin"
        }
      ]
    }
  }
