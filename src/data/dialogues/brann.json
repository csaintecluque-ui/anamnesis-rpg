  "nodes": {
    "demande": {
      "text": "Ah ! Pardon, je range. Enfin, j’essaie. J’ai perdu une caisse d’outils en tombant du chariot, sur la route de l’est. Si maître Cendrefer l’apprend, je suis mort. Et deux Rôdeurs-Épine tournent autour : je n’ose pas y retourner.",
      "options": [
        {
          "text": "Je vais la chercher.",
          "next": "merci",
          "effects": [
            {
              "startQuest": "caisse-egaree"
            }
          ]
        },
        {
          "text": "Tomber d’un chariot à l’arrêt, c’est un talent.",
          "next": "ironie"
        },
        {
          "text": "Bon courage, Brann.",
          "next": "fin"
        }
      ]
    },
    "merci": {
      "text": "Vraiment ? Elle est au sud de la route, après le pont. Les Rôdeurs n’aiment pas la fumée, à ce qu’on dit, ou alors on passe en douce. Moi, je cours vite, mais dans le mauvais sens.",
      "options": [
        {
          "text": "J’y vais.",
          "next": "fin"
        }
      ]
    },
    "attente": {
      "text": "La caisse ? Toujours là-bas, avec les Rôdeurs ?",
      "options": [
        {
          "text": "Je m’en occupe.",
          "next": "fin"
        }
      ]
    },
    "rendu": {
      "text": "Ma caisse ! Tous les outils sont là ! Tiens, c’est tout ce que j’ai. Et je dirai à maître Cendrefer de te faire un prix, promis.",
      "options": [
        {
          "text": "Merci, Brann.",
          "next": "fin",
          "effects": [
            {
              "completeQuest": "caisse-egaree"
            },
            {
              "giveFers": 25
            },
            {
              "setFlag": "remise-cendrefer"
            },
            {
              "giveXp": 25
            }
          ]
        }
      ]
    },
    "apres": {
      "text": "Maître Cendrefer m’a laissé ranger tout seul, aujourd’hui. C’est une forme de confiance, je crois.",
      "options": [
        {
          "text": "Tu veux une histoire, Brann ?",
          "requires": [
            {
              "notFlag": "raconte-brann"
            }
          ],
          "next": "raconte-neutre",
          "raconter": {
            "aime": [
              "machines",
              "trains"
            ],
            "recits": {
              "savant-corvan": "raconte-savant"
            },
            "touche": "raconte-touche",
            "neutre": "raconte-neutre"
          }
        },
        {
          "text": "…",
          "next": "fin"
        }
      ]
    },
    "ironie": {
      "text": "Brann rougit jusqu’aux oreilles. — Il roulait ! Un peu. Bon. Tu m’aides, ou tu te moques ?",
      "options": [
        {
          "text": "Je vais la chercher.",
          "next": "merci",
          "effects": [
            {
              "startQuest": "caisse-egaree"
            }
          ]
        },
        {
          "text": "Je me moque.",
          "next": "fin"
        }
      ]
    },
    "raconte-neutre": {
      "text": "Brann écoute la bouche ouverte, puis se gratte la nuque. — J’ai pas tout compris. Mais je la redirai à Maître Cendrefer : il aime quand je retiens des choses.",
      "effects": [
        {
          "setFlag": "raconte-brann"
        },
        {
          "giveXp": 5
        }
      ],
      "options": [
        {
          "text": "Bon courage, Brann.",
          "next": "fin"
        }
      ]
    },
    "raconte-touche": {
      "text": "Brann en oublie ses caisses. — Des machines plus grandes que des maisons ? Un jour, j’en ferai une. Une petite. Qui range les clous.",
      "effects": [
        {
          "setFlag": "raconte-brann"
        },
        {
          "giveXp": 10
        }
      ],
      "options": [
        {
          "text": "Bon courage, Brann.",
          "next": "fin"
        }
      ]
    },
    "raconte-savant": {
      "text": "Brann répète tout bas : « Même réussir peut tout détruire. » Il regarde ses mains noires de graisse. — Moi, je veux juste réussir une serrure. Maître Cendrefer dit que c’est déjà beaucoup.",
      "effects": [
        {
          "setFlag": "raconte-brann"
        },
        {
          "giveXp": 15
        }
      ],
      "options": [
        {
          "text": "Bon courage, Brann.",
          "next": "fin"
        }
      ]
    }
  }
