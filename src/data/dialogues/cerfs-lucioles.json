  "nodes": {
    "cerfs": {
      "text": "Une dizaine de cerfs traversent la clairière sans bruit. Leurs bois s’allument et s’éteignent, des lanternes qui respireraient. Le dernier boite : une flèche lui sort du flanc.",
      "options": [
        {
          "text": "Rester immobile et regarder.",
          "next": "regard",
          "effects": [
            {
              "setFlag": "rencontre-cerfs-vus"
            },
            {
              "giveXp": 10
            }
          ]
        },
        {
          "text": "Les suivre sans un bruit.",
          "requires": [
            {
              "skill": "survival",
              "min": 2
            }
          ],
          "next": "suivre",
          "effects": [
            {
              "setFlag": "rencontre-cerfs-vus"
            },
            {
              "giveXp": 10
            },
            {
              "heal": 10
            }
          ]
        },
        {
          "text": "Retirer la flèche, doucement.",
          "requires": [
            {
              "skill": "medicine",
              "min": 2
            }
          ],
          "next": "fleche",
          "effects": [
            {
              "setFlag": "rencontre-cerfs-vus"
            },
            {
              "giveXp": 15
            }
          ]
        },
        {
          "text": "Les laisser passer.",
          "next": "fin"
        }
      ]
    },
    "regard": {
      "text": "Le plus grand s’arrête et te regarde un long moment, puis repart. Quand la dernière lumière disparaît, tu te rends compte que tu retenais ton souffle.",
      "options": [
        {
          "text": "Reprendre son souffle.",
          "next": "fin"
        }
      ]
    },
    "suivre": {
      "text": "Ils te mènent jusqu’à une source claire, puis s’évanouissent dans les fougères. L’eau est fraîche et douce ; tu te sens mieux.",
      "options": [
        {
          "text": "Boire, puis repartir.",
          "next": "fin"
        }
      ]
    },
    "partis": {
      "text": "La clairière est redevenue sombre et silencieuse.",
      "options": [
        {
          "text": "Partir.",
          "next": "fin"
        }
      ]
    },
    "fleche": {
      "text": "Le cerf se laisse faire, tremblant de tout son corps. La flèche porte une marque de Ferros. Quand tu relèves la tête, le troupeau t’attend à l’orée, puis s’éteint d’un coup, comme on souffle une bougie.",
      "options": [
        {
          "text": "Garder la flèche, et repartir.",
          "next": "fin"
        }
      ]
    }
  }
}
