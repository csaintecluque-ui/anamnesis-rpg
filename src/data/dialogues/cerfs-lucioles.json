          "next": "fin"
        }
      ]
    },
    "regard": {
      "text": "Le plus grand s’arrête et te regarde un long moment, puis repart. Quand la dernière lumière disparaît, tu te rends compte que tu retenais ton souffle.",
      "options": [
        {
          "text": "Reprendre son souffle.",
          "next": "fin"
