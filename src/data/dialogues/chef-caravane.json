              "giveFers": -15
            }
          ]
        },
        {
          "text": "Une autre fois.",
          "next": "accueil"
        }
      ]
    },
    "trajet-gardebois": {
      "text": "La caravane roule sans hâte, de borne en borne. Le soir, les lanternes du Marché des Lisières s’allument une à une entre les arbres : Gardebois.",
