  "nodes": {
    "accueil": {
      "text": "Un homme au chapeau de cuir mâchonne un bout de viande séchée. — Le chef de caravane, c’est moi. On redescend vers Gardebois demain, et tous les jours d’après. Tu en es ?",
      "options": [
        {
          "text": "Pour Gardebois.",
          "next": "gardebois"
        },
        {
          "text": "Pas aujourd’hui.",
          "next": "fin"
        }
      ]
    },
    "gardebois": {
      "text": "— 15 Fers. Rien si tu portes la marque de la Compagnie : on ne fait pas payer ceux qui nous ont rendu une sacoche.",
      "options": [
        {
          "text": "Montrer ta marque de la Compagnie.",
          "next": "trajet-gardebois",
          "requires": [
