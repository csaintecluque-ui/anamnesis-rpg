  "nodes": {
    "route": {
      "text": "Boulon marche derrière toi, et le sol tremble un peu à chaque pas. — Je retiens tout, tu sais. Les lieux, les gens. Ce que tu fais aussi.",
      "options": [
        {
          "text": "Rentre à la gare, Boulon.",
          "next": "adieu"
        },
        {
          "text": "On continue.",
          "next": "fin"
        }
      ]
    },
    "route-bon": {
      "text": "— Je retiens ce que tu fais. Jusqu’ici, j’aime ce que je retiens. C’est une sensation nouvelle. Je la range à part.",
      "options": [
        {
          "text": "Rentre à la gare, Boulon.",
          "next": "adieu"
        },
        {
          "text": "On continue.",
          "next": "fin"
        }
      ]
    },
    "route-froid": {
      "text": "Boulon ne te regarde pas. — Je retiens ce que tu fais. Je préférerais oublier certaines choses. Je ne sais pas oublier.",
      "options": [
        {
          "text": "Rentre à la gare, Boulon.",
          "next": "adieu"
        },
        {
          "text": "On continue.",
          "next": "fin"
        }
      ]
    },
    "gare": {
      "text": "— La gare de l’Ouest. Le quai sent toujours la même huile. Tu veux la caravane pour Gardebois ? Je sais à qui parler.",
      "options": [
        {
          "text": "Montrer ta marque de la Compagnie.",
          "requires": [
            {
              "flag": "membre-compagnie-lisieres"
            }
          ],
          "next": "trajet"
        },
        {
          "text": "Payer la caravane.",
          "requires": [
            {
              "notFlag": "membre-compagnie-lisieres"
            },
            {
              "fers": 15
            }
          ],
          "effects": [
            {
              "giveFers": -15
            }
          ],
          "next": "trajet"
        },
        {
          "text": "Rentre à la gare, Boulon.",
          "next": "adieu"
        },
        {
          "text": "On continue.",
          "next": "fin"
        }
      ]
    },
    "trajet": {
      "text": "Boulon hisse ta malle sur le chariot, puis s’y hisse à son tour. La caravane quitte la cendre de Ferros, passe la frontière, retrouve la forêt. Le soir, les lanternes du Marché des Lisières.",
      "options": [
        {
          "text": "Descendre du chariot.",
          "effects": [
            {
              "attendre": "midi"
            },
            {
              "attendre": "soir"
            },
            {
              "goTo": "gardebois",
              "arrivee": "entree"
            }
          ],
          "next": "fin"
        }
      ]
    },
    "adieu": {
      "text": "— Je retourne au quai. Les malles ne se porteront pas toutes seules, même libres. Tu sais où me trouver.",
      "effects": [
        {
          "quitter": "boulon"
        }
      ],
      "options": [
        {
          "text": "À bientôt, Boulon.",
          "next": "fin"
        }
      ]
    },
    "duo-1": {
      "text": "Boulon se tourne vers Liane. — Tu mâches quelque chose, la nuit. Ça sent la cave. — Ça ne te regarde pas, Boulon. — Non, dit-il. Je le retiens quand même.",
      "effects": [
        {
          "setFlag": "duo-1"
        }
      ],
      "options": [
        {
          "text": "…",
          "next": "fin"
        }
      ]
    },
    "duo-2": {
      "text": "— Tu retiens tout ? demande Liane. Même ce qui fait mal ? — Surtout ce qui fait mal. Le reste glisse. — Alors on est l’inverse, toi et moi. Elle rit, presque. Boulon range ce rire à part, avec soin.",
      "effects": [
        {
          "setFlag": "duo-2"
        }
      ],
      "options": [
        {
          "text": "…",
          "next": "fin"
        }
      ]
    },
    "duo-3": {
      "text": "Liane marche un moment près de Boulon, sans rien dire. Puis : — Si un jour j’oublie mon frère pour de bon… tu me diras son nom ? — Saule, dit Boulon. Je te le dirai aussi souvent qu’il faudra.",
      "effects": [
        {
          "setFlag": "duo-3"
        }
      ],
      "options": [
        {
          "text": "…",
          "next": "fin"
        }
      ]
    },
    "duo-3-oublie": {
      "text": "Liane marche un moment près de Boulon. — Boulon. Tu retiens tout. J’avais quelqu’un, avant ? Un frère, une sœur ? Boulon se tait longtemps. — Oui. Je te le dirai le jour où tu voudras vraiment le savoir.",
      "effects": [
        {
          "setFlag": "duo-3"
        }
      ],
      "options": [
        {
          "text": "…",
          "next": "fin"
        }
      ]
    }
  }
