            {
              "fers": 40
            }
          ],
          "effects": [
            {
              "giveFers": -40
            }
          ]
        },
        {
          "text": "Prendre un billet : les cheminots te font un prix.",
          "next": "train-ironheart",
          "requires": [
            {
              "quest": "audience",
              "status": "done"
            },
            {
              "flag": "rail-travailleurs"
