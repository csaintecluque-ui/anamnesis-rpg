              "setFlag": "yeti-portes-reglee"
            }
          ]
        },
        {
          "text": "Il y a une fille dehors, Sigrun. Tu peux la trouver ?",
          "next": "guide",
          "requires": [
            {
              "quest": "epreuve-blizzard",
              "status": "active"
            },
            {
              "notFlag": "sigrun-reperee"
            }
          ]
        },
        {
          "text": "Je te laisse.",
          "next": "fin"
        }
      ]
    },
    "guide": {
      "text": "— Sigrun ? La grande sœur des renards de glace. Dix Fers. Personne ne paie un Yéti, alors je fais payer. Il prend son bâton et sa corde.",
      "options": [
        {
          "text": "Dix Fers. Allons-y.",
          "next": "fin",
          "requires": [
            {
              "fers": 10
            }
          ],
          "effects": [
            {
              "giveFers": -10
