          "roll": {
            "skill": "crafting",
            "difficulty": 16
          },
          "failNext": "rate"
        },
        {
          "text": "Plus tard.",
          "next": "fin"
        }
      ]
    },
    "rate": {
      "text": "Tu te trompes deux fois ; Hiran’Amra, de loin, corrige d’un geste sans rien dire. Puis, sous tes doigts, un éclat tiède, qui bat. Un cristal vivant.",
      "options": [
        {
          "text": "Le mettre à part, pour qu’il retourne à la Mer de Verre.",
