  "nodes": {
    "controle": {
      "text": "Un patrouilleur en armure noircie lève sa visière rouge. — Funiculaire des Manufactures-Moyennes. Laissez-passer.",
      "options": [
        {
          "text": "Montrer le sauf-conduit du Triumvirat.",
          "requires": [
            {
              "item": "sauf-conduit"
            }
          ],
          "next": "sauf"
        },
        {
          "text": "Acheter un laissez-passer de visiteur.",
          "requires": [
            {
              "fers": 10
            }
          ],
          "next": "achat",
          "effects": [
            {
              "giveFers": -10
            }
          ]
        },
        {
          "text": "Bluffer : « Je livre pour l’atelier Cendrefer. »",
          "next": "bluff-ok",
          "roll": {
            "skill": "subterfuge",
            "difficulty": 13
          },
          "failNext": "bluff-rate"
        },
        {
          "text": "Je repasserai.",
          "next": "fin"
        }
      ]
    },
    "sauf": {
      "text": "Il fait tourner le sceau d’émeraude entre ses gros doigts. — Laissez-passer diplomatique de Verdantis. Pas d’histoires là-haut, compris ?",
      "effects": [
        {
          "setFlag": "laissez-passer-ironheart"
        }
      ],
      "options": [
        {
          "text": "Monter.",
          "next": "fin",
          "effects": [
            {
              "goTo": "ironheart-manufactures",
              "arrivee": "funiculaire-arrivee"
            }
          ]
        },
        {
          "text": "Plus tard.",
          "next": "fin"
        }
      ]
    },
    "achat": {
      "text": "— Dix Fers. Visite d’une semaine, Manufactures-Moyennes seulement. Il tamponne un carton gris et te le tend. — Sept jours. Après, tu repasses à la caisse, comme tout le monde.",
      "effects": [
        {
          "setFlagFor": "laissez-passer-ironheart",
          "days": 7
        }
      ],
      "options": [
        {
          "text": "Monter.",
          "next": "fin",
          "effects": [
            {
              "goTo": "ironheart-manufactures",
              "arrivee": "funiculaire-arrivee"
            }
          ]
        },
        {
          "text": "Plus tard.",
          "next": "fin"
        }
      ]
    },
    "bluff-ok": {
      "text": "— Cendrefer ? Bon. Pour aujourd’hui. Dépêche-toi, et pas de détours.",
      "effects": [
        {
          "setFlagFor": "laissez-passer-ironheart",
          "days": 1
        }
      ],
      "options": [
        {
          "text": "Monter.",
          "next": "fin",
          "effects": [
            {
              "goTo": "ironheart-manufactures",
              "arrivee": "funiculaire-arrivee"
            }
          ]
        },
        {
          "text": "Plus tard.",
          "next": "fin"
        }
      ]
    },
    "bluff-rate": {
      "text": "— Sans bon de livraison ? Circule, avant que je te garde au poste le temps de vérifier.",
      "options": [
        {
          "text": "Circuler.",
          "next": "fin"
        }
      ]
    },
    "passe": {
      "text": "— Laissez-passer en règle. Le funiculaire part quand il part.",
      "options": [
        {
          "text": "Monter.",
          "next": "fin",
          "effects": [
            {
              "goTo": "ironheart-manufactures",
              "arrivee": "funiculaire-arrivee"
            }
          ]
        },
        {
          "text": "Plus tard.",
          "next": "fin"
        }
      ]
    },
    "liste": {
      "text": "Le patrouilleur pointe ton cou du menton. — Un cristal. Nom, provenance. Il griffonne dans un carnet noir. — Ferros tient des listes : qui porte un cristal, on aime savoir où il dort. Rien de personnel.",
      "effects": [
        {
          "setFlag": "liste-ferros"
        }
      ],
      "options": [
        {
          "text": "C’est interdit ?",
          "next": "liste-pourquoi"
        },
        {
          "text": "Et le funiculaire ?",
          "requires": [
            {
              "notFlag": "laissez-passer-ironheart"
            }
          ],
          "next": "controle"
        },
        {
          "text": "Et le funiculaire ?",
          "requires": [
            {
              "flag": "laissez-passer-ironheart"
            }
          ],
          "next": "passe"
        },
        {
          "text": "Bon.",
          "next": "fin"
        }
      ]
    },
    "liste-pourquoi": {
      "text": "— Interdit, non. Surveillé. Les technomanciens, on les surveille de près, et qui joue au feu sans être pyromancien aussi. Garde-le sous ta chemise, et tout ira bien.",
      "options": [
        {
          "text": "Et le funiculaire ?",
          "requires": [
            {
              "notFlag": "laissez-passer-ironheart"
            }
          ],
          "next": "controle"
        },
        {
          "text": "Et le funiculaire ?",
          "requires": [
            {
              "flag": "laissez-passer-ironheart"
            }
          ],
          "next": "passe"
        },
        {
          "text": "Compris.",
          "next": "fin"
        }
      ]
    },
    "rouille": {
      "text": "Il te saisit le poignet. Sous la peau, tes veines luisent de la couleur du cristal. Il lâche aussitôt. — Rouille de l’âme. Ça, ce n’est plus une liste : c’est un signalement. À moins que tu aies une bonne raison.",
      "options": [
        {
          "text": "Bluffer : « Une brûlure de forge, rien d’autre. »",
          "next": "rouille-bluff",
          "roll": {
            "skill": "subterfuge",
            "difficulty": 13
          },
          "failNext": "rouille-cellule"
        },
        {
          "text": "Lui glisser vingt Fers.",
          "next": "rouille-payee",
          "requires": [
            {
              "fers": 20
            }
          ],
          "effects": [
            {
              "giveFers": -20
            }
          ]
        },
        {
          "text": "Lâche ce poignet. Tu n’as rien vu.",
          "requires": [
            {
              "skill": "command",
              "min": 4
            }
          ],
          "next": "rouille-ordre"
        },
        {
          "text": "Je n’ai rien à cacher.",
          "next": "rouille-cellule"
        }
      ]
    },
    "rouille-bluff": {
      "text": "— Une brûlure. Il te fixe trois secondes de trop. — Alors soigne-la, et couvre-la : le prochain sera moins myope que moi.",
      "effects": [
        {
          "setFlag": "rouille-ame"
        }
      ],
      "options": [
        {
          "text": "Et le funiculaire ?",
