    "rouille-cellule": {
      "text": "Le poste : une cellule de fer, un banc, un seau. On t’y garde « le temps de vérifier ton statut ». Au matin, un Veilleur de Rouille note tes veines, ton nom, ta pension, et l’on te relâche. Te voilà fiché·e, à l’encre rouge.",
      "night": true,
      "effects": [
        {
          "setFlag": "rouille-ame"
        },
        {
          "setFlag": "rouille-signalee"
        },
        {
          "avancer": 1
        },
        {
          "attendre": "matin"
        }
      ],
      "options": [
        {
          "text": "Sortir.",
          "next": "fin"
        }
      ]
    },
    "rouille-ordre": {
      "text": "Il lâche ton poignet comme un fer trop chaud et recule d’un pas, sans savoir pourquoi. — Je n’ai rien vu. Mais couvre ça : le prochain n’obéira peut-être pas.",
      "effects": [
