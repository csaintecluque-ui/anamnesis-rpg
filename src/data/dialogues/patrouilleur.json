        {
          "text": "Et le funiculaire ?",
          "next": "passe",
          "requires": [
            {
              "flag": "laissez-passer-ironheart"
            }
          ]
        },
        {
          "text": "Bon.",
          "next": "fin"
        }
      ]
    },
    "rouille-payee": {
      "text": "Les Fers disparaissent dans son gant. Il n’écrit rien. — Inspecté. Couvre ça, que je n’aie pas à le revoir. Ici, ce qu’on te laisse passer, ça se paie. Toujours.",
      "effects": [
        {
          "setFlag": "rouille-ame"
        }
      ],
      "options": [
