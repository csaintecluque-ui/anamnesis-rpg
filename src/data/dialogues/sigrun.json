            },
            {
              "setFlag": "fin-epreuve-blizzard-vivante"
            },
            {
              "giveXp": 60
            }
          ]
        },
        {
          "text": "Lui frictionner les mains, la soigner ici.",
          "next": "soignee",
          "effects": [
