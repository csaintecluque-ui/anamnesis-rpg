  "nodes": {
    "accueil": {
      "text": "Bienvenue à la Racine ! Ici, on mange chaud et on parle fort. Assieds-toi : chez Sylvan, les Gardiens de Mémoire sont toujours bien reçus.",
      "options": [
        {
          "text": "Manger ou dormir ?",
          "next": "servir"
        },
        {
          "text": "Quelles nouvelles ?",
          "next": "rumeurs"
        },
        {
          "text": "Au revoir.",
          "next": "fin"
        }
      ]
    },
    "repas": {
      "text": "Soupe de racines, pain de mousse et une part de tarte aux baies. Ça remet d’aplomb, pas vrai ?",
      "options": [
        {
          "text": "Merci, Sylvan.",
          "next": "accueil"
        }
      ]
    },
    "rumeurs": {
      "text": "On dit que la maladie des souvenirs vient de la Gare, depuis que Ferros y creuse. La petite Nell, chez les Lunelierre, ne reconnaît plus sa propre berceuse… Et Brann, le gamin de Tobias, a perdu une caisse sur la route de l’est.",
      "options": [
        {
          "text": "Et l’herboriste, Liane ?",
          "next": "liane"
        },
        {
          "text": "Merci.",
          "next": "accueil"
        }
      ]
    },
    "liane": {
      "text": "Liane ? Toujours au bord du ruisseau, près du marché, le nez dans ses herbes. Elle est brusque, mais personne ne soigne mieux qu’elle.",
      "options": [
        {
          "text": "Merci.",
          "next": "accueil"
        }
      ]
    },
    "ilyane-chante": {
      "text": "Ilyane a chanté au cercle des lanternes, hier soir ! Avec un vieux carnet revenu de Canopéa. Elle chante faux comme une casserole, mais j’ai pleuré dans ma tarte.",
      "effects": [
        {
          "setFlag": "sylvan-ilyane-chante-dit"
        }
      ],
      "options": [
        {
          "text": "Merci pour la nouvelle.",
          "next": "accueil"
        }
      ]
    },
    "triumvirat": {
      "text": "Les nouvelles vont vite, par le courrier des Nacelliers : tu as parlé devant le Triumvirat Vert ! À la Racine, on boit à ta santé. Enfin, au jus de baies. Tu veux un verre ?",
      "effects": [
        {
          "setFlag": "sylvan-triumvirat-dit"
        }
      ],
      "options": [
        {
          "text": "Merci pour la nouvelle.",
          "next": "accueil"
        }
      ]
    },
    "servir": {
      "text": "— Une soupe, ou une chambre ? La chambre du fond est calme : on n’y entend que le ruisseau.",
      "options": [
        {
          "text": "Un repas chaud.",
          "requires": [
            {
              "fers": 8
            }
          ],
          "effects": [
            {
              "giveFers": -8
            },
            {
              "heal": 15
            }
          ],
          "next": "repas"
        },
        {
          "text": "Une chambre jusqu’au matin.",
          "requires": [
            {
              "fers": 6
            }
          ],
          "effects": [
            {
              "giveFers": -6
            },
            {
              "dormir": "matin"
            }
          ],
          "next": "dodo"
        },
        {
          "text": "Une chambre jusqu’à la nuit.",
          "requires": [
            {
              "fers": 6
            }
          ],
          "effects": [
            {
              "giveFers": -6
            },
            {
              "dormir": "nuit"
            }
          ],
          "next": "dodo"
        },
        {
          "text": "Rien, merci.",
          "next": "accueil"
        }
      ]
    },
    "dodo": {
      "text": "Un lit de mousse, une couverture qui sent la fumée de bois. Tu dors d’une traite.",
      "options": [
        {
          "text": "Se lever.",
          "next": "fin"
        }
      ]
    },
    "accueil-2": {
      "text": "Bienvenue à la Racine ! Aujourd’hui, la caravane de midi est partie en retard : un essieu, paraît-il. Assieds-toi, la soupe, elle, est à l’heure.",
      "options": [
        {
          "text": "Manger ou dormir ?",
          "next": "servir"
        },
        {
          "text": "Quelles nouvelles ?",
          "next": "rumeurs"
        },
        {
          "text": "Au revoir.",
          "next": "fin"
        }
      ]
    },
    "accueil-3": {
      "text": "Bienvenue à la Racine ! Ce matin, Tobias a vendu trois lampes à cristal avant même d’ouvrir. Il dit que les nuits rallongent. Moi, je dis qu’il parle trop.",
      "options": [
        {
          "text": "Manger ou dormir ?",
          "next": "servir"
        },
        {
          "text": "Quelles nouvelles ?",
          "next": "rumeurs"
        },
        {
          "text": "Au revoir.",
          "next": "fin"
        }
      ]
    }
  }
